# 302.AI IndexTTS-2 配置
INDEXTTS_302_API_KEY="sk-..."
INDEXTTS_BASE_URL="https://api.302.ai"
INDEXTTS_SPEAKER_AUDIO_URL="https://your-domain.com/speaker.wav"
INDEXTTS_EMOTION_AUDIO_URL="https://your-domain.com/emotion.wav"

# HeyGen API / MCP 配置
HEYGEN_API_KEY="your-heygen-api-key"
HEYGEN_MCP_TRANSPORT="direct" # direct | sse | stdio
HEYGEN_MCP_SERVER_URL="http://localhost:8000/sse"
MCP_SSE_AUTH_TOKEN="generate-a-long-random-token"
MCP_SSE_HOST="127.0.0.1"
MCP_SSE_ALLOWED_ORIGINS=""
MCP_MAX_PAID_CALLS_PER_HOUR="10"

# Provider output host allow-lists (comma separated; extend only with observed provider CDN hosts)
INDEXTTS_DOWNLOAD_HOSTS="302.ai"
HEYGEN_DOWNLOAD_HOSTS="heygen.com,heygen.ai"
PIXVERSE_DOWNLOAD_HOSTS="openlux.ai,pixverse.ai,pixverseai.cn"
FAL_DOWNLOAD_HOSTS="fal.ai,fal.run,fal.media"

# PixVerse / OpenLux 对口型
OPENLUX_API_KEY=""
OPENLUX_API_BASE_URL="https://api.openlux.ai"
OPENLUX_LIPSYNC_MODEL="pixverse-lipsync"
PIXVERSE_SOURCE_HOSTS="pixverseai.cn,openlux.ai"

# VEED Lipsync (fal.ai)
FAL_KEY=""
FAL_VEED_MODEL="veed/lipsync"

# 默认对口型引擎: heygen | pixverse | veed
LIPSYNC_PROVIDER="heygen"

# 应用服务配置
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 起芽主站统一 SSO 单点登录配置
MAIN_APP_URL=https://www.qycm.top
MAIN_APP_SSO_EXCHANGE_URL=https://www.qycm.top/api/external-sso/shuziren/exchange
MAIN_APP_SSO_CLIENT_SECRET=<与主站 SSO_SHUZIREN_CLIENT_SECRET 匹配的密钥>
APP_SESSION_SECRET=<本数字人子应用专属会话加密随机密钥>
PUBLIC_APP_URL=https://shuziren.qycm.top

# 独立数字人动效：默认复用 INDEXTTS_302_API_KEY / INDEXTTS_BASE_URL
# 接口需支持 /v1/audio/transcriptions (whisper-1 时间戳) 和 /v1/chat/completions
MOTION_API_KEY=""
MOTION_API_BASE_URL="https://api.302.ai"
MOTION_SUMMARY_MODEL="gpt-4o-mini"
# 可选：已安装的 Chrome Headless Shell 绝对路径；未填写时 Remotion 自动下载
REMOTION_BROWSER_EXECUTABLE=""

# 动效库编程助手：仅服务端使用，兼容 OpenAI Chat Completions 工具调用
MOTION_AGENT_BASE_URL="https://api.mixtoken.ai/v1"
MOTION_AGENT_MODEL="deepseek-v4-flash"
MOTION_AGENT_API_KEY=""
